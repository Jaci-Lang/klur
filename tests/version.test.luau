local Test = require("@klur/test")
local Version = require("@klur/core/version")
local expect = Test.expect

Test.describe("Core: Version (SemVer)", function()
    Test.it("should parse standard semantic versions", function()
        local v = Version.parse("1.2.3")
        expect(v).toBeDefined()
        expect(v.major).toBe(1)
        expect(v.minor).toBe(2)
        expect(v.patch).toBe(3)
        expect(v.prerelease).toBeNil()
    end)

    Test.it("should parse versions with 'v' prefix", function()
        local v = Version.parse("v2.5.10")
        expect(v).toBeDefined()
        expect(v.major).toBe(2)
        expect(v.minor).toBe(5)
        expect(v.patch).toBe(10)
    end)

    Test.it("should parse prerelease versions", function()
        local v = Version.parse("1.0.0-alpha.1")
        expect(v).toBeDefined()
        expect(v.major).toBe(1)
        expect(v.minor).toBe(0)
        expect(v.patch).toBe(0)
        expect(v.prerelease).toBe("alpha.1")
    end)

    Test.it("should compare versions correctly", function()
        local v1 = Version.parse("1.0.0")
        local v2 = Version.parse("1.2.0")
        local v3 = Version.parse("2.0.0")
        expect(Version.compare(v1, v2)).toBe(-1)
        expect(Version.compare(v2, v1)).toBe(1)
        expect(Version.compare(v1, v1)).toBe(0)
        expect(Version.compare(v2, v3)).toBe(-1)
    end)

    Test.it("should check caret (^) range satisfaction", function()
        expect(Version.satisfies("1.2.4", "^1.2.0")).toBe(true)
        expect(Version.satisfies("1.5.0", "^1.2.0")).toBe(true)
        expect(Version.satisfies("2.0.0", "^1.2.0")).toBe(false)
        expect(Version.satisfies("1.1.0", "^1.2.0")).toBe(false)
    end)

    Test.it("should check tilde (~) range satisfaction", function()
        expect(Version.satisfies("1.2.4", "~1.2.0")).toBe(true)
        expect(Version.satisfies("1.3.0", "~1.2.0")).toBe(false)
    end)

    Test.it("should satisfy wildcard ranges", function()
        expect(Version.satisfies("3.0.0", "*")).toBe(true)
        expect(Version.satisfies("0.1.0", "latest")).toBe(true)
    end)
end)
